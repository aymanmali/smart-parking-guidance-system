(kicad_pcb
  (version 20240108)
  (generator "smart-parking-guidance-system")
  (generator_version "1.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
    (48 "F.Fab" user)
  )
  (setup
    (pad_to_mask_clearance 0.05)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
    )
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "+12V_24V_IN")
  (net 3 "+5V")
  (net 4 "+3V3")
  (net 5 "RS485_A")
  (net 6 "RS485_B")
  (net 7 "RS485_TX")
  (net 8 "RS485_RX")
  (net 9 "RS485_DE_RE")
  (net 10 "ARROW_LEFT_G")
  (net 11 "ARROW_LEFT_R")
  (net 12 "ARROW_STR_G")
  (net 13 "ARROW_STR_R")
  (net 14 "ARROW_RIGHT_G")
  (net 15 "ARROW_RIGHT_R")

  ;; 80mm x 55mm Board Outline (Edge.Cuts)
  (gr_rect
    (start 100 80)
    (end 180 135)
    (stroke (width 0.15) (type solid))
    (fill none)
    (layer "Edge.Cuts")
    (uuid "b1c2d3e4-2222-4333-8444-000000000001")
  )

  ;; Silkscreen Title
  (gr_text "SPG-CTRL-v1 | SmartPark 300 | ESP32 + RS485"
    (at 140 84 0)
    (layer "F.SilkS")
    (uuid "b1c2d3e4-2222-4333-8444-000000000002")
    (effects (font (size 1.4 1.4) (thickness 0.2)))
  )
)
